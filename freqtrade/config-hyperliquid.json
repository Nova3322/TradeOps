{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "trading-hyperliquid-worker",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "stake_currency": "USDC",
  "stake_amount": 10,
  "max_open_trades": 20,
  "timeframe": "5m",
  "initial_state": "running",
  "process_only_new_candles": true,
  "position_adjustment_enable": true,
  "force_entry_enable": true,
  "cancel_open_orders_on_exit": true,
  "exchange": {
    "name": "hyperliquid",
    "walletAddress": "",
    "privateKey": "",
    "hip3_dexes": ["xyz"],
    "pair_whitelist": ["BTC/USDC:USDC", "XYZ-TSLA/USDC:USDC"],
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": {"enabled": false, "bids_to_ask_delta": 1}
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "limit",
    "force_entry": "limit",
    "force_exit": "limit",
    "stoploss": "limit",
    "stoploss_on_exchange": false
  },
  "unfilledtimeout": {"entry": 10, "exit": 10, "unit": "minutes"},
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": "",
    "authorized_users": [],
    "allow_custom_messages": true,
    "notification_settings": {
      "status": "on",
      "warning": "on",
      "startup": "on",
      "entry": "on",
      "entry_fill": "on",
      "entry_cancel": "on",
      "exit": "on",
      "exit_fill": "on",
      "exit_cancel": "on",
      "protection_trigger": "on",
      "protection_trigger_global": "on",
      "strategy_msg": "on",
      "show_candle": "off"
    },
    "reload": false
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "local-dry-run-jwt-secret-change-me",
    "ws_token": "overridden-by-environment",
    "CORS_origins": [],
    "username": "overridden-by-environment",
    "password": "overridden-by-environment"
  }
}
