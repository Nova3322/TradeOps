# Copy to .env.local and fill locally. Never put real values in this template.
TRADING_ENVIRONMENT=local
TRADING_DATABASE_URL=
TRADING_LOG_LEVEL=INFO
TRADING_API_HOST=127.0.0.1
TRADING_API_PORT=8000
TRADING_PUBLIC_BASE_URL=http://127.0.0.1:8000
TRADING_ALLOW_MOCK_IDENTITY=false
# Generate a unique value of at least 32 characters. Production rejects the
# built-in local development value.
TRADING_SESSION_SIGNING_SECRET=
TRADING_SESSION_TTL_SECONDS=28800
TRADING_ACTION_TOKEN_TTL_SECONDS=300
# Required before the account API can save or rotate exchange credentials.
# Generate 32 random bytes as URL-safe base64; keep the value in a secret manager.
TRADING_CREDENTIAL_ENCRYPTION_KEY=
# Synthetic local identities; replace locally without committing personal identifiers.
TRADING_LOCAL_ADMIN_USERNAME=trading-admin
TRADING_LOCAL_PROPOSER_USERNAME=trading-proposer
TRADING_LOCAL_SECOND_REVIEWER_USERNAME=trading-reviewer
# Local startup stores the generated administrator password in
# .local/passwords/TRADING_LOCAL_ADMIN_USERNAME (mode 0600).
# Override only through a secret manager.
# TRADING_LOCAL_ADMIN_PASSWORD=replace-with-a-strong-local-secret

# External integrations remain disabled unless their explicit runtime gate is enabled.
# Telegram uses real private-chat Bot API long polling when enabled. Keep it off
# until the token has been rotated and the allowlisted user is ready to send /start.
TRADING_TELEGRAM_BOT_TOKEN=
TRADING_TELEGRAM_BOT_USERNAME=
TRADING_TELEGRAM_ENABLED=false
TRADING_TELEGRAM_ALLOWED_USERNAME=
TRADING_TELEGRAM_INTERNAL_USERNAME=
TRADING_TELEGRAM_POLL_TIMEOUT_SECONDS=20
TRADING_PERPTAPE_BASE_URL=https://perptape.com
TRADING_PERPTAPE_API_KEY=
TRADING_PERPTAPE_SERVICE_USERNAME=perptape
TRADING_PERPTAPE_CONTRACT_VERSION=breakouts-v1
TRADING_PERPTAPE_CACHE_SECONDS=60
TRADING_PERPTAPE_TIMEOUT_SECONDS=15
# The official Perptape alert WebSocket is the primary continuous channel only when
# both this gate and the runtime worker gate below are explicitly enabled.
TRADING_PERPTAPE_WEBSOCKET_ENABLED=false
TRADING_PERPTAPE_WEBSOCKET_URL=wss://perptape.com/ws/v1/alerts
TRADING_PERPTAPE_WEBSOCKET_HEARTBEAT_TIMEOUT_SECONDS=45
TRADING_PERPTAPE_WEBSOCKET_RECONCILIATION_SECONDS=300
TRADING_PERPTAPE_WEBSOCKET_RECONNECT_INITIAL_SECONDS=1
TRADING_PERPTAPE_WEBSOCKET_RECONNECT_MAX_SECONDS=30
TRADING_PERPTAPE_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=8
# Automatic Perptape proposals still stop at a frozen PENDING_REVIEW proposal.
# The worker, Team account and every field below must be explicit before enabling.
TRADING_PERPTAPE_AUTO_PROPOSAL_ENABLED=false
TRADING_PERPTAPE_AUTO_PROPOSAL_ACCOUNT_ID=
TRADING_PERPTAPE_AUTO_PROPOSAL_ENVIRONMENT=LIVE
TRADING_PERPTAPE_AUTO_PROPOSAL_RISK_TIER=MEDIUM
TRADING_PERPTAPE_AUTO_PROPOSAL_MIN_TIMEFRAMES=3
TRADING_PERPTAPE_AUTO_PROPOSAL_NOTIONAL=100
TRADING_PERPTAPE_AUTO_PROPOSAL_MAX_RISK=1
TRADING_PERPTAPE_AUTO_PROPOSAL_INVALIDATION_BPS=200
TRADING_PERPTAPE_AUTO_PROPOSAL_EXPIRES_MINUTES=480
# The independent read-only worker is opt-in. It refreshes Perptape availability,
# venue facts, reconciliation and configured NoTilt Vault facts; it never sends orders.
TRADING_RUNTIME_SYNC_ENABLED=false
TRADING_RUNTIME_SYNC_INTERVAL_SECONDS=60
TRADING_RUNTIME_SYNC_SERVICE_USERNAME=runtime-sync
TRADING_FACT_ADAPTER_ENABLED=false
TRADING_FACT_ADAPTER_HOST=127.0.0.1
TRADING_FACT_ADAPTER_PORT=8010
TRADING_FACT_ADAPTER_BEARER_TOKEN=
TRADING_FACT_ADAPTER_BINDING_REFRESH_SECONDS=60
TRADING_FACT_ADAPTER_STALE_AFTER_SECONDS=360
TRADING_FACT_ADAPTER_RECONCILIATION_SECONDS=300
TRADING_FACT_ADAPTER_FALLBACK_SECONDS=60
TRADING_RUNTIME_BINANCE_SYMBOL=BTCUSDT
TRADING_RUNTIME_HYPERLIQUID_SYMBOL=BTC
TRADING_RUNTIME_OKX_SYMBOL=BTC-USDT-SWAP
TRADING_RUNTIME_BYBIT_SYMBOL=BTCUSDT
# Team notification delivery is a separate least-privilege process. It only
# decrypts notification route credentials and has no trading or capital adapter.
TRADING_NOTIFICATION_WORKER_ENABLED=false
TRADING_NOTIFICATION_WORKER_INTERVAL_SECONDS=15
TRADING_NOTIFICATION_WORKER_BATCH_SIZE=50
# Exact comma-separated public DNS hosts. Empty blocks email delivery even if a
# Team route exists; Slack/Lark/Telegram are unaffected.
TRADING_NOTIFICATION_EMAIL_SMTP_ALLOWED_HOSTS=
# Every Freqtrade endpoint, mode, RPC token and auth secret is stored per exact
# Team/Account/Venue in an encrypted database envelope.
TRADING_FREQTRADE_WORKERS_ENABLED=false
TRADING_FREQTRADE_TIMEOUT_SECONDS=5
TRADING_FREQTRADE_CONFIRMATION_TIMEOUT_SECONDS=90
TRADING_FREQTRADE_LIVE_LEVERAGE=1
# Durable READY intents are consumed only by this separate process. LIVE sends
# additionally require the database LIVE_ORDER_SEND Gate and exact verified binding.
TRADING_EXECUTION_WORKER_ENABLED=false
TRADING_CAPITAL_CONTINUATION_WORKER_ENABLED=false
TRADING_CAPITAL_CONTINUATION_WORKER_SCAN_SECONDS=30
TRADING_CAPITAL_CONTINUATION_WORKER_BATCH_SIZE=20
TRADING_EXECUTION_WORKER_INTERVAL_SECONDS=5
TRADING_EXECUTION_WORKER_BATCH_SIZE=20
TRADING_BINANCE_RECV_WINDOW_MS=10000
# Dedicated Wallet API credentials. Use a separate IP-restricted key; do not
# reuse the trading key. The application never returns or logs these values.
TRADING_BINANCE_CAPITAL_BASE_URL=https://api.binance.com
TRADING_BINANCE_CAPITAL_API_KEY=
TRADING_BINANCE_CAPITAL_API_SECRET=
TRADING_BINANCE_CAPITAL_ACCOUNT_ID=
TRADING_BINANCE_CAPITAL_TIMEOUT_SECONDS=8
# This transport switch and the durable CAPITAL_TRANSFER gate must both be on
# before a confirmed withdrawal can be submitted. Keep both off during setup.
TRADING_BINANCE_CAPITAL_WITHDRAW_ENABLED=false
TRADING_HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
# Hyperliquid capital fallback is signing-free; it records public account and
# receipt evidence and emits unsigned wallet handoffs only.
TRADING_HYPERLIQUID_ACCOUNT_ADDRESS=
TRADING_HYPERLIQUID_API_WALLET_ADDRESS=
TRADING_HYPERLIQUID_SUBACCOUNT_ADDRESS=
TRADING_NOTILT_ENABLED=false
TRADING_NOTILT_AGENT_ADDRESS=
TRADING_NOTILT_ETHEREUM_VAULT_ADDRESS=
TRADING_NOTILT_BSC_VAULT_ADDRESS=
TRADING_NOTILT_ARBITRUM_VAULT_ADDRESS=
TRADING_NOTILT_GATEWAY_TIMEOUT_SECONDS=30
TRADING_NOTILT_ETHEREUM_MIN_CONFIRMATIONS=12
TRADING_NOTILT_BSC_MIN_CONFIRMATIONS=15
TRADING_NOTILT_ARBITRUM_MIN_CONFIRMATIONS=20
TRADING_SAFE_SPENDING_ENABLED=false
TRADING_SAFE_SPENDING_ARBITRUM_RPC_URL=
TRADING_SAFE_SPENDING_GATEWAY_TIMEOUT_SECONDS=20

# Direct capital paths remain fail-closed until every non-secret scope and limit is set.
# All NoTilt transactions are unsigned SDK output for a separate human-controlled wallet.
TRADING_CAPITAL_DIRECT_VAULT_ID=
TRADING_CAPITAL_DIRECT_VAULT_ADDRESS=
TRADING_CAPITAL_DIRECT_SAFE_ADDRESS=
TRADING_CAPITAL_DIRECT_SAFE_DELEGATE_ADDRESS=
TRADING_CAPITAL_DIRECT_OWNED_ARBITRUM_ADDRESS=
TRADING_CAPITAL_DIRECT_BINANCE_ACCOUNT_ID=
TRADING_CAPITAL_DIRECT_BINANCE_DEPOSIT_ADDRESS=
TRADING_CAPITAL_DIRECT_BINANCE_WITHDRAWAL_ADDRESS=
TRADING_CAPITAL_DIRECT_HYPERLIQUID_ACCOUNT_ID=
TRADING_CAPITAL_DIRECT_HYPERLIQUID_BRIDGE_ADDRESS=
TRADING_CAPITAL_DIRECT_TREASURY_PROVIDER=NOTILT_VAULT
TRADING_CAPITAL_DIRECT_ASSET=USDC
TRADING_CAPITAL_DIRECT_NETWORK=ARBITRUM
TRADING_CAPITAL_DIRECT_MAX_AMOUNT=
TRADING_CAPITAL_DIRECT_MAX_FEE=
TRADING_CAPITAL_ARBITRUM_RPC_URL=

# Private keys belong only in the untracked .env.local or a production secret manager.
# The application never returns or logs their values.
# NoTilt intentionally has no key field: it returns unsigned transactions for wallet review.
